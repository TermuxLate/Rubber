    "description": "Команда pkg упрощает работу с пакетами: установка, обновление, удаление и поиск. Является дружественной обёрткой над apt и поддерживает подкоманды install, upgrade, search и т.д.",
    "syntax": "pkg [подкоманда] [аргументы]",
    "options": [
      { "flag": "install <пакет>", "desc": "Установить пакет" },
      { "flag": "upgrade", "desc": "Обновить установленные пакеты" },
      { "flag": "search <запрос>", "desc": "Поиск пакета" },
      { "flag": "list-all", "desc": "Список всех доступных пакетов" }
    ],
    "examples": [
      { "desc": "Обновить индексы и пакеты", "cmd": "pkg update && pkg upgrade" },
      { "desc": "Установить git", "cmd": "pkg install git" }
